# What one accession's record says.
#
# The facts the list already carries, and then the record itself laid out
# by its own shape. Sections are the subtree's top-level keys — for a
# sample that is what a sample has, and nothing beside it in the record.
render('submission_accessions/accession', row: @row).merge(
  record: render('records/slice', slice: @slice, outline: @outline)
)
