# locals: (attachment:, url:)
#
# `url` is handed in rather than built here, because the route that names
# a file depends on which record holds it — a request's upload is reached
# through the request, a submission's through the submission — and the
# route is what re-asks whether the caller may have it (see
# AttachmentDownload). All this partial knows is that there is a file.

attachment.attached? ? {
  filename: attachment.filename,
  url:      url
} : nil
