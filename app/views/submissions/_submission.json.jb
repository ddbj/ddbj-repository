# locals: (submission:)

{
  **submission.slice(
    :id,
    :source_id,
    :created_at,
    :updated_at
  ),

  # Every database, not only ST.26. This said 0 for every BioProject and
  # BioSample in the archive: the count was `entries.count`, and their
  # numbers live on projects and samples.
  accessions_count: submission.accessioned_rows.count,

  # The record as DDBJ holds it — for a chain its current state, not a file
  # Apply wrote (Submission#record_file).
  ddbj_record: (submission.record_file? ? {filename: submission.record_filename, url: submission_file_url(submission, 'ddbj_record')} : nil),
  flatfile_na: render('attachment', attachment: submission.flatfile_na, url: submission_file_url(submission, 'flatfile_na')),
  flatfile_aa: render('attachment', attachment: submission.flatfile_aa, url: submission_file_url(submission, 'flatfile_aa'))
}
