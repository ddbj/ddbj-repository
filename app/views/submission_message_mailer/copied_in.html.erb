<% app_url = Rails.application.config_for(:app).app_url! %>
<% thread_url = File.join(app_url, 'admin', 'submission_requests', @request.id.to_s) %>

<p>
  <strong><%= @message.user.uid %></strong> copied you in on
  <%= @request.db.humanize %> request
  (<%= @request.submission&.source_id.presence || "##{@request.id}" %>),
  where they wrote to the submitter (<%= @request.user.uid %>):
</p>

<% if @message.body.present? %>
  <blockquote style="border-left: 3px solid #ccc; padding-left: 1em; color: #555;">
    <%= simple_format @message.body %>
  </blockquote>
<% end %>

<%= render 'files', message: @message %>

<p>
  You are now following this request, so the submitter's replies will reach your
  queue. Stop following from the request page if you would rather not.
</p>

<p>
  <a href="<%= thread_url %>">Open the thread in the admin UI.</a>
</p>

<p>— DDBJ Repository</p>
