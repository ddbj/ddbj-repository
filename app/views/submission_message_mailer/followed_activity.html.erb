<% app_url = Rails.application.config_for(:app).app_url! %>
<% thread_url = File.join(app_url, 'admin', 'submission_requests', @request.id.to_s) %>

<p>
  <strong><%= @message.user.uid %></strong> replied to the submitter
  (<%= @request.user.uid %>) on <%= @request.db.humanize %> request
  (<%= @request.submission&.source_id.presence || "##{@request.id}" %>), which you are
  following:
</p>

<% if @message.body.present? %>
  <blockquote style="border-left: 3px solid #ccc; padding-left: 1em; color: #555;">
    <%= simple_format @message.body %>
  </blockquote>
<% end %>

<%= render 'files', message: @message %>

<p>
  Nothing is being asked of you — this is what happened on a request you follow.
  Stop following from the request page if you would rather not hear about it.
</p>

<p>
  <a href="<%= thread_url %>">Open the thread in the admin UI.</a>
</p>

<p>— DDBJ Repository</p>
