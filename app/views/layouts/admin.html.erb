<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= [content_for(:title).presence, 'Administration'].compact.join(' — ') %></title>
    <%= csrf_meta_tags %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= stylesheet_link_tag 'admin' %>
    <%= javascript_importmap_tags 'admin' %>
    <%= yield :head %>
  </head>
  <body class="bg-body-tertiary">
    <%# Task-axis navigation: what a curator is trying to do, not which %>
    <%# database the data lives in. DB is a filter on the lists below. %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to admin_root_path, class: 'navbar-brand' do %>
          DDBJ Repository <span class="opacity-50 fw-normal">Admin</span>
        <% end %>

        <% if current_user %>
          <ul class="navbar-nav me-auto">
            <%= render 'layouts/admin_nav_item',
                       label:  'Needs action',
                       path:   admin_root_path,
                       active: controller_path == 'admin/needs_action',
                       badge:  needs_action_count,
                       badge_class: needs_action_count.positive? ? 'text-bg-danger' : 'text-bg-secondary' %>

            <%= render 'layouts/admin_nav_item',
                       label:  'My queue',
                       path:   admin_my_queue_path,
                       active: controller_path == 'admin/my_queue',
                       badge:  my_queue_count,
                       badge_class: 'text-bg-secondary' %>

            <%= render 'layouts/admin_nav_item',
                       label:  'All requests',
                       path:   admin_submission_requests_path,
                       active: controller_path == 'admin/submission_requests' %>

            <%= render 'layouts/admin_nav_item',
                       label:  'Data migration',
                       path:   admin_migration_runs_path,
                       active: controller_path == 'admin/migration_runs' %>

            <li class="nav-item dropdown">
              <button type="button" class="nav-link dropdown-toggle <%= 'active' if admin_tools_section? %>" data-bs-toggle="dropdown" aria-expanded="false">
                Tools
              </button>

              <ul class="dropdown-menu">
                <li><%= link_to 'Users',                admin_users_path,                class: 'dropdown-item' %></li>
                <li><%= link_to 'Distribution notices', admin_distribution_notices_path, class: 'dropdown-item' %></li>
                <li><%= link_to 'Regenerate flatfiles', admin_regenerate_flatfiles_path, class: 'dropdown-item' %></li>
                <li><%= link_to 'Jobs',                 admin_mission_control_jobs_path, class: 'dropdown-item' %></li>
              </ul>
            </li>
          </ul>

          <ul class="navbar-nav">
            <li class="nav-item dropdown">
              <button type="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <%= current_user.uid %>
              </button>

              <ul class="dropdown-menu dropdown-menu-end">
                <li><%= link_to 'Back to repository', '/web/', class: 'dropdown-item', data: {turbo: false} %></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= button_to 'Logout', admin_session_path, method: :delete, class: 'dropdown-item', data: {turbo: false} %>
                </li>
              </ul>
            </li>
          </ul>
        <% end %>
      </div>
    </nav>

    <main class="container-xxl pb-5">
      <% flash.each do |level, message| %>
        <%# data-controller="flash-focus" scrolls the banner into view on %>
        <%# render so a post-save redirect doesn't leave the notice above %>
        <%# the curator's current scroll position (turbo-refresh-scroll is %>
        <%# preserve so the form-bottom scroll position survives). %>
        <%# The token value re-emits per render so Stimulus fires the %>
        <%# value-change callback even when Turbo morph reuses the .alert %>
        <%# element across saves (connect() would only fire on first mount). %>
        <div class="alert alert-<%= flash_bootstrap_class(level) %> alert-dismissible fade show"
             role="alert"
             data-controller="flash-focus"
             data-flash-focus-token-value="<%= SecureRandom.hex(8) %>">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

  </body>
</html>
