<%# What the form currently adds up to, refreshed as it is filled in. %>
<%# %>
<%# The button lives here rather than under the fields because its %>
<%# label is part of the answer: pressing "Regenerate 3 submissions" %>
<%# and pressing "Regenerate 7,254 submissions" should not look like %>
<%# the same act. %>
<div class="card h-100 bg-body-tertiary" data-test-scope-summary>
  <div class="card-body d-flex flex-column">
    <div class="text-uppercase small fw-semibold text-body-secondary">This run</div>

    <div class="d-flex align-items-baseline gap-2 mt-2">
      <span class="display-6"><%= number_with_delimiter(scope.total) %></span>
      <span class="text-body-secondary"><%= 'submission'.pluralize(scope.total) %></span>
    </div>

    <% estimate = regeneration_estimate(scope.total) %>

    <p class="small text-body-secondary mb-3">
      <%= scope.source_label %><%= " · roughly #{estimate} of job time" if estimate %>
    </p>

    <dl class="row row-cols-1 g-0 small mb-3">
      <div class="d-flex justify-content-between border-top py-1">
        <dt class="fw-normal text-body-secondary">LOCUS dates</dt>
        <dd class="mb-0"><%= scope.locus_date ? "set to #{scope.locus_date}" : 'unchanged' %></dd>
      </div>

      <%# Only when there is a date to place. The file is rewritten %>
      <%# whole whatever this says — it is the date that lands on some %>
      <%# entries and not others. %>
      <% if scope.locus_date %>
        <div class="d-flex justify-content-between border-top py-1">
          <dt class="fw-normal text-body-secondary">Written to</dt>
          <dd class="mb-0"><%= scope.dated_label %></dd>
        </div>
      <% end %>

      <%# Asked before every heavy action, and answered the same way %>
      <%# each time — a curator should never have to remember which %>
      <%# operations mail the submitter. %>
      <div class="d-flex justify-content-between border-top border-bottom py-1">
        <dt class="fw-normal text-body-secondary">Submitters notified</dt>
        <dd class="mb-0">no</dd>
      </div>
    </dl>

    <%# One run at a time. Two over the same submission would have two %>
    <%# workers rewriting one flatfile, and the loser's accession %>
    <%# history entry describes a file that is no longer there. %>
    <% if blocking %>
      <p class="small text-warning-emphasis mb-2">
        The run started at <%= format_datetime(blocking.started_at) %> is still going.
        <%= number_with_delimiter(blocking.done) %> of <%= number_with_delimiter(blocking.total) %> done.
      </p>
    <% else %>
      <% scope.problems.each do |problem| %>
        <p class="small text-warning-emphasis mb-2"><%= problem %></p>
      <% end %>
    <% end %>

    <div class="mt-auto">
      <% label = "Regenerate #{number_with_delimiter(scope.total)} #{'submission'.pluralize(scope.total)}" %>

      <% if blocking %>
        <%= submit_tag label, class: 'btn btn-primary w-100', disabled: true %>
      <% elsif scope.all_target? %>
        <%# Every submission in the database goes through the %>
        <%# confirmation; a handful does not. The gate is on the size %>
        <%# of the act, not on the screen it was started from. %>
        <%= link_to "#{label}…", confirm_admin_regenerate_flatfiles_path(scope.to_params),
                    class: "btn btn-warning w-100#{' disabled' unless scope.ready?}",
                    data:  {turbo_frame: 'confirm_dialog'} %>
      <% else %>
        <%= submit_tag label, class: 'btn btn-primary w-100', disabled: !scope.ready? %>
      <% end %>
    </div>
  </div>
</div>
