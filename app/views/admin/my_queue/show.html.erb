<% content_for :title, 'My queue' %>

<%= render 'admin/shared/breadcrumb', items: [{label: 'My queue'}] %>

<h1 class="display-6 mb-2">My queue</h1>

<p class="text-body-secondary mb-4">
  Requests whose curation rows — the BP project, or any BS sample — are assigned
  to <code><%= current_user.uid %></code>.
</p>

<%= render 'admin/submission_requests/request_list',
           requests:          @requests,
           sample_aggregates: @sample_aggregates,
           pagy:              @pagy,
           return_to:         'my_queue',
           empty_message:     'Nothing is assigned to you.' %>
