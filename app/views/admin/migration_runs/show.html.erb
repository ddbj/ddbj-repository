<% content_for :title, "Migration run ##{@migration_run.id}" %>

<%= render 'admin/shared/breadcrumb', items: [
  {label: 'Data migration', path: admin_migration_runs_path},
  {label: "Run ##{@migration_run.id}"}
] %>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <h1 class="display-6 mb-0">Run #<%= @migration_run.id %></h1>
      <span class="badge text-bg-light border"><%= db_label(@migration_run.db) %></span>
      <%= migration_run_status_badge(@migration_run) %>
    </div>

    <p class="text-body-secondary mb-0">
      started <%= format_datetime(@migration_run.started_at) || '—' %>

      <%# A run only stops writing counters when its worker has gone, so %>
      <%# how long ago it last moved is the fact that decides whether %>
      <%# anyone is still waiting on it. %>
      <% if @migration_run.queued_status? || @migration_run.running_status? %>
        · <strong class="<%= 'text-warning-emphasis' if @migration_run.stale? %>">
            last progress <%= elapsed_time(@migration_run.updated_at) %>
          </strong>
      <% end %>
    </p>
  </div>

  <% if @touched_count.positive? %>
    <%= link_to "#{number_with_delimiter(@touched_count)} submissions →",
                admin_submission_requests_path(db: @migration_run.db), class: 'btn btn-outline-secondary' %>
  <% end %>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-body">
        <% if @migration_run.queued_status? %>
          <p class="text-body-secondary mb-0">Waiting for a worker to pick it up.</p>
        <% elsif @migration_run.enumerating? %>
          <p class="text-body-secondary mb-0">Counting the source rows…</p>
        <% else %>
          <%# No estimate of what is left. `started_at` is preserved %>
          <%# across a Continuation resume, so a run interrupted by a %>
          <%# Friday deploy and resumed on Monday would charge the idle %>
          <%# weekend to its rate and report days for an hour of work. %>
          <%# Measuring the time actually spent would need the job to %>
          <%# record it. %>
          <div class="d-flex justify-content-between small mb-1">
            <span><%= migration_run_rows(@migration_run) %></span>
            <span class="text-body-secondary"><%= @migration_run.progress_percent %>%</span>
          </div>

          <div class="progress" role="progressbar"
               aria-valuenow="<%= @migration_run.progress_percent %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: <%= @migration_run.progress_percent %>%;"></div>
          </div>
        <% end %>
      </div>
    </div>

    <%# The counter keys are the job's vocabulary. Spelling out what each %>
    <%# one meant is the difference between a table only its author can %>
    <%# read and a report. %>
    <% if @migration_run.counters.any? %>
      <h2 class="h6 mb-2">What happened to each row</h2>

      <table class="table table-sm border align-middle mb-4" data-test-outcomes>
        <tbody>
          <% @migration_run.outcome_rows.each do |key, label, count| %>
            <tr>
              <td>
                <%= label %>
                <code class="small text-body-secondary ms-1"><%= key %></code>
              </td>
              <td class="text-end fw-semibold"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% groups = @migration_run.unimported_groups %>

    <%# "Rows that did not import" rather than "Failures": a row refused %>
    <%# for belonging to another submitter is counted `cross_user` and a %>
    <%# row that stopped the sweep is not counted at all, so a heading %>
    <%# saying "failures" would contradict the `failed` line above it. %>
    <% if groups.any? %>
      <div class="d-flex align-items-baseline gap-2 mb-2">
        <h2 class="h6 mb-0">Rows that did not import</h2>
        <span class="small text-body-secondary">
          <%= pluralize(number_with_delimiter(groups.sum { it[:count] }), 'row') %> · grouped by cause
        </span>
      </div>

      <table class="table table-sm border align-middle mb-3" data-test-unimported-groups>
        <tbody>
          <% groups.each do |group| %>
            <tr>
              <td>
                <%= group[:cause] %>
                <span class="small text-body-secondary">
                  · <%= group[:source_ids].join(', ') %><%= ', …' if group[:truncated] %>
                </span>
              </td>
              <td class="text-end fw-semibold"><%= number_with_delimiter(group[:count]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <p class="mb-4">
        <%= link_to 'Download the full list', failures_admin_migration_run_path(@migration_run),
                    class: 'btn btn-outline-secondary btn-sm', data: {turbo: false} %>
      </p>
    <% end %>

    <%# Whatever is not a row failure: why it was abandoned, what stopped %>
    <%# it. Short, and about the run rather than about the data. %>
    <% @migration_run.notices.each do |notice| %>
      <p class="small text-warning-emphasis"><%= notice %></p>
    <% end %>

    <% if @migration_run.error_log.present? %>
      <details class="mb-4">
        <summary class="small text-body-secondary">Show the raw log</summary>

        <pre class="bg-body-tertiary p-3 border rounded small mt-2 mb-0"><%= @migration_run.error_log %></pre>
      </details>
    <% end %>
  </div>

  <div class="col-lg-4">
    <div class="card mb-3">
      <div class="card-body">
        <h2 class="h6 mb-3">This run</h2>

        <dl class="small mb-3">
          <div class="d-flex justify-content-between border-top py-1">
            <dt class="fw-normal text-body-secondary">Database</dt>
            <dd class="mb-0"><%= db_label(@migration_run.db) %></dd>
          </div>

          <div class="d-flex justify-content-between border-top py-1">
            <dt class="fw-normal text-body-secondary">Started</dt>
            <dd class="mb-0"><%= format_datetime(@migration_run.started_at) || '—' %></dd>
          </div>

          <div class="d-flex justify-content-between border-top border-bottom py-1">
            <dt class="fw-normal text-body-secondary">Finished</dt>
            <dd class="mb-0"><%= format_datetime(@migration_run.finished_at) || '—' %></dd>
          </div>
        </dl>

        <%# Last, and small: nobody decides anything from a UUID. It is %>
        <%# here to be quoted, which is why it is selectable rather than %>
        <%# prominent. %>
        <div class="small text-body-secondary">Run UUID</div>
        <code class="small user-select-all"><%= @migration_run.uuid %></code>
      </div>
    </div>

    <%# Abandoning is how a run whose worker died stops blocking every %>
    <%# future import of its database. Shown whenever the run is live, %>
    <%# with the reason it cannot be pressed yet — hiding it made a %>
    <%# curator who came back later look for a control that had never %>
    <%# been there. %>
    <% if @migration_run.queued_status? || @migration_run.running_status? %>
      <div class="card">
        <div class="card-body">
          <h2 class="h6 mb-2">Give up on this run</h2>

          <% if @migration_run.stale? %>
            <p class="small text-body-secondary">
              Nothing has moved for over an hour, so the worker is gone. Abandoning marks the
              run failed and lets a new one start; the rows it already imported stay as they
              are, and the next run picks them up from the source again.
            </p>

            <%= button_to 'Abandon this run', abandon_admin_migration_run_path(@migration_run),
                          method: :patch, class: 'btn btn-outline-warning btn-sm' %>
          <% else %>
            <p class="small text-body-secondary">
              Only possible once nothing has moved for
              <%= distance_of_time_in_words(MigrationRun::STALE_AFTER) %> — it last progressed
              <strong><%= elapsed_time(@migration_run.updated_at) %></strong>, so a worker
              is still on it. Abandoning a live run would put a second worker on the same
              database.
            </p>

            <button type="button" class="btn btn-outline-warning btn-sm" disabled>Abandon this run</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
