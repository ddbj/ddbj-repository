<% content_for :title, "Migration run ##{@migration_run.id}" %>

<%= render 'admin/shared/breadcrumb', items: [
  {label: 'Migration runs',  path: admin_migration_runs_path},
  {label: "##{@migration_run.id}"}
] %>

<h1 class="display-6 mb-4">Migration run #<%= @migration_run.id %></h1>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Database</dt>
      <dd class="col-sm-9"><%= db_label(@migration_run.db) %></dd>

      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9">
        <%= migration_run_status_badge(@migration_run) %>

        <%# A run only stops writing counters when its worker has gone, %>
        <%# so how long ago it last moved is the fact that decides %>
        <%# whether anyone is still waiting on it. %>
        <% if @migration_run.queued_status? || @migration_run.running_status? %>
          <span class="text-body-secondary small">
            last progress <%= elapsed_label(@migration_run.updated_at) %> ago
          </span>
        <% end %>
      </dd>

      <dt class="col-sm-3">UUID</dt>
      <dd class="col-sm-9"><code><%= @migration_run.uuid %></code></dd>

      <dt class="col-sm-3">Started</dt>
      <dd class="col-sm-9"><%= format_datetime(@migration_run.started_at) || '—' %></dd>

      <dt class="col-sm-3">Finished</dt>
      <dd class="col-sm-9"><%= format_datetime(@migration_run.finished_at) || '—' %></dd>

      <dt class="col-sm-3">Submissions touched</dt>
      <dd class="col-sm-9">
        <% if @touched_count.positive? %>
          <%= link_to "#{number_with_delimiter(@touched_count)} submission(s)",
                      admin_submission_requests_path(db: @migration_run.db) %>
        <% else %>
          —
        <% end %>
      </dd>
    </dl>

    <%# Abandoning is how a run whose worker died stops blocking every %>
    <%# future import of its database. Offered only once it has stopped %>
    <%# moving: a second worker on the same database would write over %>
    <%# the first, so "it looks stuck" is not enough — it has to BE %>
    <%# stuck, and the timestamp above is how that is judged. %>
    <% if @migration_run.queued_status? || @migration_run.running_status? %>
      <hr>

      <% if @migration_run.stale? %>
        <%= button_to 'Abandon this run', abandon_admin_migration_run_path(@migration_run),
                      method: :patch, class: 'btn btn-outline-danger btn-sm' %>

        <p class="text-body-secondary small mb-0 mt-2">
          Nothing has moved for over an hour, so the worker is gone. Abandoning marks the run
          failed and lets a new one start; the rows it already imported stay as they are, and
          the next run picks them up from the source again.
        </p>
      <% else %>
        <p class="text-body-secondary small mb-0">
          Still progressing. A run can only be abandoned once it has been silent for
          <%= distance_of_time_in_words(MigrationRun::STALE_AFTER) %> — abandoning a live one
          would put a second worker on the same database.
        </p>
      <% end %>
    <% end %>
  </div>
</div>

<h2 class="h5 mt-4 mb-3">Progress</h2>

<% if @migration_run.total.to_i.zero? %>
  <p class="text-body-secondary">Total not yet enumerated.</p>
<% else %>
  <div class="progress mb-2" style="height: 1.5rem;" role="progressbar"
       aria-valuenow="<%= @migration_run.progress_percent %>" aria-valuemin="0" aria-valuemax="100">
    <div class="progress-bar" style="width: <%= @migration_run.progress_percent %>%">
      <%= @migration_run.progress_percent %>%
    </div>
  </div>

  <p class="text-body-secondary">
    <%= number_with_delimiter(@migration_run.counters_total) %>
    /
    <%= number_with_delimiter(@migration_run.total) %>
    rows processed
  </p>
<% end %>

<h2 class="h5 mt-4 mb-3">Outcome counters</h2>

<% if @migration_run.counters.any? %>
  <table class="table table-sm border w-auto">
    <thead class="table-light">
      <tr><th>Outcome</th><th class="text-end">Count</th></tr>
    </thead>
    <tbody>
      <% @migration_run.counters.sort_by {|_, n| -n.to_i }.each do |outcome, n| %>
        <tr>
          <td><code><%= outcome %></code></td>
          <td class="text-end"><%= number_with_delimiter(n) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-body-secondary">No counters yet.</p>
<% end %>

<% if @migration_run.error_log.present? %>
  <h2 class="h5 mt-4 mb-3">Errors</h2>

  <pre class="bg-body-tertiary p-3 border rounded small"><%= @migration_run.error_log %></pre>
<% end %>
