<% content_for :title, 'Data migration' %>

<%= render 'admin/shared/breadcrumb', items: [
  {label: 'Data migration'}
] %>

<h1 class="display-6 mb-1">Data migration</h1>

<p class="text-body-secondary mb-4">
  Imports records from the D-way database. One run per database at a time — the
  current state of each is below.
</p>

<%# One card per database, because that is the unit the rule is about. %>
<%# The old screen led with a list of runs and left the reader to work %>
<%# out which database was busy, then refused the press with an alert. %>
<div class="row g-3 mb-4" data-test-db-states>
  <% @states.each do |state| %>
    <%= render 'state_card', state: state %>
  <% end %>
</div>

<h2 class="h5 mb-3">All runs</h2>

<%# Chips rather than a select and a Filter button: three choices, and %>
<%# each is one press. %>
<div class="btn-group btn-group-sm mb-3" role="group" aria-label="Filter by database">
  <% [[nil, 'Both'], *db_options.map(&:reverse).select { MigrationRun::DBS.include?(it.first) }].each do |value, label| %>
    <%= link_to label, admin_migration_runs_path(db: value),
                class: "btn btn-outline-secondary#{' active' if params[:db].presence == value}" %>
  <% end %>
</div>

<table class="table border align-middle">
  <thead class="table-light">
    <tr>
      <th>Run</th>
      <th>Database</th>
      <th>State</th>
      <th>Rows</th>
      <th>Started</th>
      <th>Duration</th>
    </tr>
  </thead>

  <tbody>
    <% @migration_runs.each do |run| %>
      <tr>
        <td><%= link_to "##{run.id}", admin_migration_run_path(run) %></td>
        <td><%= db_label(run.db) %></td>

        <td>
          <%= migration_run_status_badge(run) %>

          <%# A run that stopped reporting is not the same as one still %>
          <%# working, and the list is where that difference is cheapest %>
          <%# to see. %>
          <% if run.stale? %>
            <span class="small text-warning-emphasis">not reporting</span>
          <% end %>
        </td>

        <td>
          <%= migration_run_rows(run) %>

          <%# "Abandoned" without a reason makes the reader open the run %>
          <%# to find out why. The reason is already recorded. %>
          <% if (reason = run.abandoned_reason) %>
            <span class="small text-body-secondary">· <%= reason %></span>
          <% end %>
        </td>

        <td class="text-nowrap"><%= format_datetime(run.started_at) %></td>

        <td class="text-nowrap text-body-secondary">
          <%= run.started_at ? distance_of_time_in_words(run.started_at, run.finished_at || Time.current) : '—' %>
        </td>
      </tr>
    <% end %>

    <% if @migration_runs.empty? %>
      <tr>
        <td colspan="6" class="text-center text-body-secondary py-4">No migration runs yet.</td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render 'admin/shared/pagy_nav', pagy: @pagy %>
