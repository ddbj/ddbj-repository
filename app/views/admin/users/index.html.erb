<% content_for :title, 'Users' %>

<h1 class="display-6 mb-1">Users</h1>

<p class="text-body-secondary mb-3">
  Find a DDBJ account to review their submissions, leave notes for other curators,
  or open the submitter view as them.
</p>

<%= form_with url: admin_users_path, method: :get, local: true, class: 'mb-3' do %>
  <div class="row g-2 align-items-center">
    <div class="col-md-5">
      <label for="users-query" class="visually-hidden">Search accounts</label>
      <%= search_field_tag :q, @query, id: 'users-query', class: 'form-control',
                           placeholder: 'Account, name, organization, email…' %>
    </div>

    <div class="col-auto">
      <%= submit_tag 'Search', class: 'btn btn-primary' %>
    </div>

    <%# Which population, as one choice rather than an `admin` column the %>
    <%# reader has to scan. "Who is staff" is a question, so it gets an %>
    <%# answer in one click. %>
    <div class="col-auto">
      <div class="btn-group btn-group-sm" role="group" aria-label="Population">
        <% Admin::UsersController::SEGMENTS.each do |value, label| %>
          <%= link_to admin_users_path(request.query_parameters.merge(segment: value)),
                      class: "btn btn-outline-secondary #{'active' if @segment == value}",
                      'aria-current': ('true' if @segment == value) do %>
            <%= label %>
            <% if value == 'staff' %>
              <span class="badge text-bg-secondary ms-1"><%= @staff_count %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# The old wording was "include users without submission requests", %>
    <%# which asks the reader to negate a negative. Same filter, put the %>
    <%# way somebody would actually say it. %>
    <%# %>
    <%# Absent on Staff, where it does not apply: a ticked box above a %>
    <%# list that ignores it is worse than no box, because unticking it %>
    <%# changes nothing and the reader is left wondering what did. %>
    <div class="col-auto" <%= 'hidden' if @segment == 'staff' %>>
      <div class="form-check">
        <%# The hidden partner is what makes unticking expressible: an %>
        <%# unchecked box sends nothing at all, and "absent" has to mean %>
        <%# "first visit, default on" — so without this the filter could be %>
        <%# turned on and never off again. %>
        <%= hidden_field_tag :submitted, '', id: nil %>
        <%= check_box_tag :submitted, '1', @submitted, id: 'users-submitted', class: 'form-check-input',
                          onchange: 'this.form.requestSubmit()' %>
        <label for="users-submitted" class="form-check-label">Has submitted before</label>
      </div>
    </div>
  </div>

  <%= hidden_field_tag :segment, @segment %>
<% end %>

<table class="table table-hover border align-middle">
  <thead class="table-light">
    <tr>
      <th>Account</th>
      <th>Name / organization</th>
      <th>Email</th>
      <th class="text-end">Requests</th>
      <th class="text-end">Applied</th>
      <th>Last activity</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <% profile = @profiles_by_uid[user.uid] %>
      <tr class="position-relative">
        <td>
          <%= link_to user.uid, admin_user_path(uid: user.uid), class: 'stretched-link text-decoration-none text-reset' %>
        </td>

        <%# A profile we could not fetch is a fact about the fetch. Saying %>
        <%# so beats dropping the row, which used to make a real account %>
        <%# look like one that does not exist. %>
        <td>
          <% if profile %>
            <%= profile['full_name'] %>
            <% if profile['organization'].present? %>
              <span class="text-body-secondary">· <%= profile['organization'] %></span>
            <% end %>
          <% else %>
            <span class="text-body-secondary fst-italic">Profile unavailable — DDBJ Account did not answer</span>
          <% end %>
        </td>

        <td>
          <% if profile %>
            <%= profile['email'] %>
          <% elsif user.email.present? %>
            <%= user.email %>
            <span class="text-body-secondary small">(local copy)</span>
          <% else %>
            —
          <% end %>
        </td>

        <td class="text-end"><%= @counts[:requests][user.id] %></td>
        <td class="text-end"><%= @counts[:submissions][user.id] %></td>

        <%# Replaces `account_type_number`, a raw code no decision was ever %>
        <%# made from. Whether an account has gone quiet is one people do %>
        <%# make. %>
        <td class="text-nowrap text-body-secondary">
          <% if (seen = @counts[:last_activity][user.id]) %>
            <%= elapsed_time(seen) %>
          <% else %>
            —
          <% end %>
        </td>
      </tr>
    <% end %>

    <% if @users.empty? %>
      <tr>
        <td colspan="6">
          <%# The search is one of three things narrowing this list, and %>
          <%# only it is worth blaming when there is one. Clearing keeps %>
          <%# the segment and the submitted filter: a button that moves %>
          <%# the reader to a different population clears more than it %>
          <%# says. %>
          <% if @query.present? %>
            <%= empty_state :filtered, 'No accounts match this search.',
                            "Within #{Admin::UsersController::SEGMENTS[@segment]}." do %>
              <%= link_to 'Clear the search',
                          admin_users_path(segment: @segment, submitted: ('1' if @submitted)),
                          class: 'btn btn-sm btn-outline-secondary' %>
            <% end %>
          <% elsif @submitted %>
            <%# `submitted` defaults to on for every segment but Staff, so
                an empty list here is a narrowed one — accounts in the
                segment do exist, they just have not submitted anything.
                Saying "empty is the outcome" and offering nothing to
                press would be the screen hiding its own filter. %>
            <%= empty_state :filtered, 'No accounts in this segment have submitted anything.',
                            "Within #{Admin::UsersController::SEGMENTS[@segment]}." do %>
              <%= link_to 'Include accounts that have not submitted',
                          admin_users_path(segment: @segment),
                          class: 'btn btn-sm btn-outline-secondary' %>
            <% end %>
          <% else %>
            <%= empty_state :clear, 'No accounts in this segment.' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# The cap belongs on the result line, not in a standing caveat above the %>
<%# table: with the match count on screen its existence explains itself, %>
<%# and it only needs saying when it actually bit. %>
<p class="text-body-secondary small">
  <%= pluralize(@total, 'account') %>
  <%= @query.present? ? "match “#{@query}”" : 'in this segment' %>.
  <% if @total > Admin::UsersController::LIMIT %>
    Up to <%= Admin::UsersController::LIMIT %> are listed at a time — narrow the search
    if the one you want is missing.
  <% end %>
</p>
