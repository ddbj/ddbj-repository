<% content_for :title, @user.uid %>

<%= render 'admin/shared/breadcrumb', items: [
  {label: 'Users', path: admin_users_path},
  {label: @user.uid}
] %>

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
  <div>
    <h1 class="display-6 mb-1"><%= @user.uid %></h1>

    <p class="text-body-secondary mb-0">
      <% if @profile %>
        <%= [@profile['full_name'], @profile['organization'], @profile['email']].compact_blank.join(' · ') %>
      <% else %>
        <span class="fst-italic">Profile unavailable — DDBJ Account did not answer</span>
        <% if @user.email.present? %>
          · <%= @user.email %> <span class="small">(local copy)</span>
        <% end %>
      <% end %>
    </p>
  </div>

  <%= link_to "#{pluralize(@counts[:requests][@user.id], 'submission request')} →",
              admin_submission_requests_path(q: @user.uid),
              class: 'btn btn-outline-secondary' %>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <%# The old screen offered a card saying "Submission requests (14)" and %>
    <%# nothing else, so answering "how is this person doing" always meant %>
    <%# a detour through the ledger. Three rows answer it here. %>
    <section class="card mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline gap-2 flex-wrap mb-2">
          <h2 class="h6 card-title mb-0">Recent requests</h2>
          <span class="small text-body-secondary">
            <%= @counts[:requests][@user.id] %> total ·
            <%= @counts[:submissions][@user.id] %> applied ·
            <%= link_to 'see all', admin_submission_requests_path(q: @user.uid) %>
          </span>
        </div>
      </div>

      <% if @recent.empty? %>
        <div class="card-body border-top pt-3">
          <p class="small text-body-secondary fst-italic mb-0">This account has never submitted.</p>
        </div>
      <% else %>
        <div class="list-group list-group-flush border-top">
          <% @recent.each do |request| %>
            <% submission = request.submission %>
            <div class="list-group-item d-flex align-items-center gap-3 flex-wrap">
              <%= link_to "##{request.id}", admin_submission_request_path(request), class: 'fw-semibold text-nowrap' %>
              <span class="badge text-bg-light border"><%= db_label(request.db) %></span>
              <code class="small text-body-secondary"><%= submission&.source_id || '—' %></code>

              <span class="flex-fill small">
                <%= request_state_display(request, submission, @sample_aggregates) %>
              </span>

              <span class="small text-body-secondary text-nowrap"><%= elapsed_label(request.updated_at) %> ago</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="card">
      <div class="card-body">
        <div class="d-flex align-items-baseline gap-2 flex-wrap mb-2">
          <h2 class="h6 card-title mb-0">Internal notes</h2>
          <span class="small text-body-tertiary">Visible to curators only · not to the submitter</span>
        </div>

        <p class="small text-body-secondary">
          Context other curators should know — past correspondence, agreements,
          quirks of this group's data.
        </p>

        <%= form_with model: @user, url: admin_user_path(uid: @user.uid), method: :patch, local: true do |f| %>
          <%= f.label :notes, class: 'visually-hidden' %>
          <%= f.text_area :notes, class: 'form-control textarea-autogrow mb-2' %>

          <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <%# A field several curators write to is only worth trusting if %>
            <%# it says who wrote it. One column's worth of provenance is %>
            <%# the difference between a shared note and a rumour. %>
            <span class="small text-body-secondary">
              <% if @user.notes_updated_at %>
                Last edited by <%= @user.notes_updated_by&.uid || 'unknown' %>
                · <%= l @user.notes_updated_at.to_date %>
              <% else %>
                Never edited.
              <% end %>
            </span>

            <%= f.submit 'Save notes', class: 'btn btn-primary btn-sm' %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <div class="col-lg-5">
    <%# Sourced, so it is obvious which of these a curator could change and %>
    <%# which belong to DDBJ Account. They used to sit in one `dl` with the %>
    <%# local admin flag, which made all of them look editable. %>
    <section class="card mb-4">
      <div class="card-body">
        <h2 class="h6 card-title">Account</h2>

        <dl class="row mb-2 small">
          <dt class="col-5 fw-normal text-body-secondary">Role here</dt>
          <dd class="col-7"><%= @user.admin? ? 'Curator' : 'Submitter' %></dd>

          <dt class="col-5 fw-normal text-body-secondary">Account type</dt>
          <dd class="col-7"><%= account_type_label(@profile&.dig('account_type_number')) %></dd>

          <dt class="col-5 fw-normal text-body-secondary">Registered</dt>
          <dd class="col-7"><%= l @user.created_at.to_date %></dd>

          <dt class="col-5 fw-normal text-body-secondary">Last sign-in</dt>
          <dd class="col-7">
            <%= @user.last_signed_in_at ? l(@user.last_signed_in_at.to_date) : 'No sign-in recorded' %>
          </dd>

          <dt class="col-5 fw-normal text-body-secondary">Profile source</dt>
          <dd class="col-7">DDBJ Account</dd>
        </dl>

        <p class="small text-body-tertiary mb-0">
          Name, organization and account type are held by DDBJ Account and cannot be edited here.
        </p>
      </div>
    </section>

    <%# Not a button at the bottom of the page. Acting as somebody else %>
    <%# writes to their record under their name, so what happens is said %>
    <%# before it is offered, in the colour the proxy banner uses. %>
    <section class="card border-warning-subtle">
      <div class="card-body">
        <span class="badge text-bg-warning mb-2">PROXY</span>

        <h2 class="h6 card-title">Open the submitter view as this user</h2>

        <p class="small text-body-secondary">
          You see exactly what <%= @user.uid %> sees. Anything you do is recorded as a
          proxy action by you, including messages. End the session from the banner at
          the top.
        </p>

        <%= button_to 'Start proxy session',
                      admin_user_proxy_login_path(user_uid: @user.uid),
                      method: :post,
                      class:  'btn btn-warning',
                      data:   {turbo: false} %>
      </div>
    </section>
  </div>
</div>
