<% content_for :title, "##{@request.id} — Record & history" %>

<%= render layout: 'workbench', locals: {tab: :record} do %>
  <% if @submission.nil? %>
    <p class="text-body-secondary mb-0">
      No submission yet — this request has not been applied, so there is no
      record and no history.
    </p>
  <% else %>
    <%# The record itself, laid out for reading — first, because the tab
        is called Record & history and because reading precedes editing.
        It also shows the fields the editors below do not cover (grants,
        relations, anything a later schema adds), so it is the map for
        the rest of the tab.

        Not on Overview: that screen answers "what state is this in and
        what is the next move", with `next_action` at the top for exactly
        that reason, and a whole record above the fold would push the move
        out of sight — the arrangement the task-axis rebuild took apart.

        Curators were being given the raw JSON, which is the whole record
        and unreadable. A curated subset would be readable and not the
        whole record — and what was asked for was the whole thing. So the
        layout comes from the shape of the data (see RecordOutline) and
        nothing here names a field: v3 is still moving, and a screen that
        knew the fields would need revising on every revision.

        The JSON stays, below. It is what somebody reaches for when they
        need to see exactly what is stored, and there is no reason to take
        it away. %>
    <% if @outline || @materialised %>
      <section class="card mb-4" data-test-record-outline>
        <div class="card-body">
          <h2 class="h6 card-title">Record</h2>

          <% if @outline.nil? %>
            <p class="text-body-secondary small mb-0" data-test-record-too-large>
              Not laid out — the record is <%= number_to_human_size(@materialised_size) %>
              (limit <%= number_to_human_size(Admin::SubmissionDetail::CANONICAL_DISPLAY_SIZE_LIMIT) %>).
              A record this size is a bag of samples or entries, and those have their own
              screens; the JSON below is the whole of it.
            </p>
          <% end %>

          <% if @outline&.elided? %>
            <p class="text-body-secondary small" data-test-record-elided-note>
              Parts of this record are too deep to lay out and are marked
              &ldquo;not expanded&rdquo;. The JSON below is the whole of it.
            </p>
          <% end %>

          <% sections = @outline&.sections || [] %>

          <% if @outline && sections.empty? %>
            <p class="text-body-secondary small mb-0">The record carries nothing.</p>
          <% end %>

          <%# Which of the v3 keys this record has is itself an answer. Every
              database shares the same fourteen, so an absent one means "no
              such thing here" — and "does this record have sequences?" is
              otherwise a question you answer by scrolling. %>
          <% if sections.any? %>
            <p class="small mb-3" data-test-record-carries>
              <span class="text-body-secondary">Carries</span>
              <% sections.each do |section| %>
                <a href="#record-<%= section.key %>" class="badge text-bg-light border text-decoration-none"><%= section.key %></a>
              <% end %>
              <span class="text-body-secondary ms-1">
                <%= sections.size %> of the <%= RecordOutline.schema_key_count %> v3 keys
              </span>
            </p>
          <% end %>

          <% sections.each do |section| %>
            <%# The section heading is the page's skeleton and was drawn
                weaker than the body it introduces, so the joins
                disappeared. Small is fine — uppercase and letter-spacing
                make it a structural label — but it takes the body colour,
                a rule above, and more room above than below, because a
                heading belongs to what follows it. %>
            <div class="mt-4 pt-3 border-top" id="record-<%= section.key %>" data-test-record-section="<%= section.key %>">
              <h3 class="small fw-semibold text-uppercase mb-2" style="letter-spacing: 0.08em;"><%= section.key %></h3>

              <%= render 'record_node', node: section.node %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Record content editors. These write v3 fields through the patch %>
    <%# chain, so they belong with the record rather than with the %>
    <%# operational state on Overview. %>
    <% if @materialised && @materialisation_error.nil? %>
      <% if @submission.bioproject_db? %>
        <%= render 'admin/project_records/curator_edit', submission: @submission %>
      <% end %>

      <%= render 'admin/submitters/curator_edit', submission: @submission %>
    <% end %>


    <h2 class="h5 mt-4">
      Patch chain
      <span class="badge text-bg-secondary"><%= @updates.size %></span>
    </h2>

    <% if @updates.any? %>
      <table class="table border align-middle">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Created</th>
            <th>Actor</th>
            <th>Source</th>
            <th class="text-end">Ops</th>
            <th>Patch</th>
            <th>Snapshot</th>
          </tr>
        </thead>
        <tbody>
          <% @updates.each do |update| %>
            <% is_current = update == @updates.last %>
            <% parsed = begin; update.parsed_patch; rescue StandardError => e; e; end %>
            <tr class="<%= 'table-info' if is_current %>">
              <td><code>#<%= update.id %></code></td>
              <td><%= format_datetime(update.created_at) %></td>
              <td><%= update.actor || '—' %></td>
              <td><span class="badge text-bg-light"><%= update.source %></span></td>
              <td class="text-end">
                <% if parsed.is_a?(StandardError) %>
                  <span class="text-danger" title="unparseable">!</span>
                <% else %>
                  <%= parsed.length %>
                <% end %>
              </td>
              <td>
                <details>
                  <summary class="small text-body-secondary" role="button">show ops</summary>
                  <% if parsed.is_a?(StandardError) %>
                    <pre class="mb-0 mt-2 small text-danger bg-body-tertiary border rounded p-2">patch unreadable: <%= parsed.class %>: <%= parsed.message %></pre>
                  <% else %>
                    <pre class="mb-0 mt-2 small bg-body-tertiary border rounded p-2"><%= JSON.pretty_generate(parsed) %></pre>
                  <% end %>
                </details>
              </td>
              <td>
                <%# Snapshot links point to the raw JSON endpoint. The %>
                <%# current row links without ?as_of so the URL stays clean %>
                <%# for the most common click target. %>
                <% if is_current %>
                  <%= link_to 'view (JSON)', materialised_admin_submission_path(@submission), class: 'btn btn-sm btn-primary' %>
                <% else %>
                  <%= link_to 'view (JSON)', materialised_admin_submission_path(@submission, as_of: update.id), class: 'btn btn-sm btn-outline-secondary' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-body-secondary">No updates have been applied yet — nothing to materialise.</p>
    <% end %>

    <h2 class="h5 mt-4">Engineering details</h2>

    <% if @materialisation_error %>
      <div class="alert alert-danger" role="alert">
        Replay failed: <%= @materialisation_error.class %>: <%= @materialisation_error.message %>.
        The patch chain table above is rendered as-is so the bad row
        (<code>#<%= @materialisation_error.try(:update_id) || '?' %></code>) can be located.
      </div>
    <% end %>

    <dl class="row">
      <dt class="col-sm-3">Canonical version</dt>
      <dd class="col-sm-9">ddbj-canon/v<%= @submission.canonical_version %></dd>

      <dt class="col-sm-3">Converter version</dt>
      <dd class="col-sm-9"><%= @submission.converter_version || '—' %></dd>

      <dt class="col-sm-3">Created / Updated</dt>
      <dd class="col-sm-9"><%= format_datetime(@submission.created_at) %> / <%= format_datetime(@submission.updated_at) %></dd>

      <% if @canonical_bytes %>
        <dt class="col-sm-3">Canonical bytes</dt>
        <dd class="col-sm-9"><%= number_with_delimiter(@canonical_bytes.bytesize) %> bytes</dd>

        <dt class="col-sm-3">Canonical SHA-256</dt>
        <dd class="col-sm-9"><code><%= @sha256 %></code></dd>
      <% elsif @materialised_size && @materialised_size > Admin::SubmissionDetail::CANONICAL_DISPLAY_SIZE_LIMIT %>
        <dt class="col-sm-3">Canonical bytes / SHA-256</dt>
        <dd class="col-sm-9 text-body-secondary">
          Skipped — materialised record is <%= number_to_human_size(@materialised_size) %>
          (limit <%= number_to_human_size(Admin::SubmissionDetail::CANONICAL_DISPLAY_SIZE_LIMIT) %>).
          Canonicalisation walks every subtree and costs ~20 s on 7 MB records;
          avoiding it keeps the page interactive.
        </dd>
      <% end %>

      <% if @materialised %>
        <dt class="col-sm-3">Materialised v3</dt>
        <dd class="col-sm-9">
          <%= link_to 'View as JSON', materialised_admin_submission_path(@submission) %>
          <%# Labelled "JSON:" to distinguish from "Canonical bytes" above — %>
          <%# they're structurally different sizes (canonical sorts keys and %>
          <%# normalises strings). %>
          <span class="text-body-secondary ms-2">JSON: <%= number_to_human_size(@materialised_size) %></span>
        </dd>
      <% end %>
    </dl>
  <% end %>
<% end %>
