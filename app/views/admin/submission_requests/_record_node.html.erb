<%# locals: (node:, dense: false) %>
<%# One node of RecordOutline, drawn by its shape. Recurses into itself,
    so nesting needs no extra template and no depth limit — the record is
    a tree and this follows it.

    `dense` is the one thing the shape does not decide: the same :fields
    has a card's width under a section and about 150px inside a table
    cell, and a 4/8 grid in the narrow one puts the key column at 50px
    where it wraps — taking the value with it and stretching every row.
    Set when recursing from :table and :list, so it follows the width
    rather than the field.

    Set from :fields too, because the grid spends the card's width in one
    go: a hash inside a hash started its own 220px key column at 220px,
    and a third at 440px, walking the values off the right of the card.
    One grid, and everything below it reads as `key: value` lines. %>

<% case node.kind %>
<% when :value %>
  <%# Free text is the only thing given room. Line breaks matter more
      than length here — a three-line address is 120 characters and
      collapses to one without this, while a long single paragraph does
      not need it and gets it anyway (harmless). %>
  <% if node.value.is_a?(String) && (node.value.length > 200 || node.value.include?("\n")) %>
    <div class="small" style="white-space: pre-wrap;"><%= node.value %></div>
  <% else %>
    <%= node.value %>
  <% end %>

<% when :empty %>
  <span class="text-body-secondary small">—</span>

<% when :elided %>
  <span class="text-body-secondary small" data-test-record-elided>not expanded — see the JSON</span>

<% when :fields %>
  <% if dense %>
    <%# key: value on one line. A single-key hash — `{environmental:
        true}` — then costs one line rather than a wrapped two-column
        grid, which is most of what made nested cells unreadable. %>
    <div class="small">
      <% node.rows.each do |key, child| %>
        <div><span class="text-body-secondary"><%= key %>:</span> <%= render 'record_node', node: child, dense: %></div>
      <% end %>
    </div>
  <% else %>
    <%# A fixed key column rather than a proportion. `col-sm-4` grows with
        the card, so on a wide screen a one-key hash puts `environmental`
        and `true` several hundred pixels apart and the pair stops reading
        as a pair. Fixed, the distance is the same however many keys there
        are — which is also why `dense` does not need widening to cover
        small hashes. A long key wraps instead of pushing the value. %>
    <dl class="mb-0 small" style="display: grid; grid-template-columns: 220px 1fr; column-gap: 1rem;">
      <% node.rows.each do |key, child| %>
        <dt class="fw-normal text-body-secondary" style="overflow-wrap: anywhere;"><%= key %></dt>
        <dd class="mb-1"><%= render 'record_node', node: child, dense: true %></dd>
      <% end %>
    </dl>
  <% end %>

<% when :list %>
  <ul class="list-unstyled mb-0 small">
    <% node.rows.each do |child| %>
      <li><%= render 'record_node', node: child, dense: true %></li>
    <% end %>
  </ul>

<% when :table %>
  <%# Wide records are common — the attribute bag alone can run to
      dozens of columns — so the table scrolls inside its own box rather
      than pushing the page sideways. %>
  <div class="table-responsive">
    <table class="table table-sm table-bordered small mb-1">
      <thead class="table-light">
        <tr>
          <% node.columns.first(RecordOutline::COLUMN_LIMIT).each do |column| %>
            <th class="text-nowrap"><%= column %></th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% node.rows.each do |cells| %>
          <tr>
            <% cells.each do |cell| %>
              <td><%= render 'record_node', node: cell, dense: true if cell %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Said, never implied. Three rows of ten thousand look like three
      rows unless the screen says otherwise — the same reading that made
      the validation report group its findings rather than show the
      first few. %>
  <% if node.columns.size > RecordOutline::COLUMN_LIMIT %>
    <p class="small text-body-secondary mb-1" data-test-record-columns-hidden>
      <%= node.columns.size - RecordOutline::COLUMN_LIMIT %> more
      <%= 'column'.pluralize(node.columns.size - RecordOutline::COLUMN_LIMIT) %>
      not shown: <%= node.columns.drop(RecordOutline::COLUMN_LIMIT).join(', ') %>
    </p>
  <% end %>
<% end %>

<%# Where the omission happened, because that is where somebody is
    reading — and browser search will not tell them. Ctrl+F answers "not
    here" for a value that is in the record and not on the page, so the
    line has to say so itself rather than rely on a note at the top of
    the card.

    The destination it names is the JSON, which is the one that is always
    true. It said "the tabs above" for a while, which is right for a BS
    submission's samples and wrong for every other collection — a BP
    record's `relations` running past the limit has no tab behind it. A
    better destination exists for exactly one section and naming it here
    would mean knowing which section that is; the card says it instead,
    where being approximate is not a promise. %>
<% if node.truncated? %>
  <p class="small text-body-secondary mb-0" data-test-record-truncated>
    Showing <%= number_with_delimiter(node.shown) %> of
    <%= number_with_delimiter(node.total) %> —
    <%= number_with_delimiter(node.hidden) %> more in the JSON below.
  </p>
<% end %>
