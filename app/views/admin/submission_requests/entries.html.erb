<% content_for :title, "##{@request.id} — Entries" %>

<%= render layout: 'workbench', locals: {tab: :samples} do %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">
      Entries
      <span class="text-body-secondary fw-normal"><%= number_with_delimiter(@state.row_count) %></span>
    </h2>
  </div>

  <%# Said here rather than discovered by a curator who retracted an entry %>
  <%# and went looking for it in the flatfile. Both halves matter: the %>
  <%# record keeps it, because the record is the account of what was %>
  <%# submitted. %>
  <%# %>
  <%# The rule on its own left the curator holding a fact and no way to %>
  <%# act on it: the flatfile is a stored file, so retracting an entry %>
  <%# does not touch it, and the only way to regenerate was a bulk tool %>
  <%# reached from elsewhere and driven by a paste of accession numbers. %>
  <%# So where there is something to leave out, the number is named and %>
  <%# the press is here — while the file on record is older than the last %>
  <%# retraction, which is the difference between a discrepancy and a %>
  <%# standing condition. "1 entry is canceled" is true for ever; "the %>
  <%# file was written before it" stops being true when it is acted on. %>
  <%# %>
  <%# Not done for them, and the reason is not only that a regeneration %>
  <%# writes LOCUS dates (it does, and it refuses where the column and %>
  <%# the record disagree — see the LOCUS date section in CLAUDE.md and %>
  <%# the 62 entries that paid for that guard). %>
  <%# %>
  <%# The general reason is that a flatfile is a function of the record, %>
  <%# the statuses AND the rules in force when it was written, and those %>
  <%# rules move: the regeneration tool says outright that it is what to %>
  <%# run after a converter change. Retracting an entry asks for one of %>
  <%# those inputs to change. Regenerating re-evaluates all of them, so %>
  <%# doing it automatically would answer a small deliberate change with %>
  <%# every rule change since the file was made — which is the shape of %>
  <%# surprise nobody can attribute afterwards. %>
  <%# %>
  <%# So the press is offered and what it does is said, rather than %>
  <%# taken. %>
  <% if @retracted_count.positive? %>
    <div class="border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3" data-test-retracted-entries>
      <div class="small flex-grow-1">
        <p class="mb-0">
          <%= number_with_delimiter(@retracted_count) %>
          <%= 'entry'.pluralize(@retracted_count) %>
          here <%= @retracted_count == 1 ? 'is' : 'are' %> canceled or withdrawn.
          Retracted entries stay in the record; the flatfile leaves them out when it is generated.
        </p>

        <p class="text-body-secondary mb-0 mt-1">
          <% if @flatfile_stale %>
            <%# Said because it is the part that surprises. The file is %>
            <%# rebuilt rather than edited, so it comes back as today's %>
            <%# rules would write it, and the record is written back with %>
            <%# it — which is the same reason the tool exists for %>
            <%# converter changes. %>
            The flatfile on record was written before the last of them. Regenerating rebuilds it from
            the stored record, and writes that record back, so it picks up any change to how the two
            are written since this one was made.
          <% else %>
            The flatfile has been written since the last of them, so it already leaves them out.
          <% end %>
        </p>

        <%# One run at a time, and the reason belongs where the press is: %>
        <%# a curator sent to the bulk tool to read this would be reading %>
        <%# it on a screen they have never seen. %>
        <% if @flatfile_stale && @blocking %>
          <p class="text-warning-emphasis mb-0 mt-1">
            The regeneration run started at <%= format_datetime(@blocking.started_at) %> is still going.
            <%= number_with_delimiter(@blocking.done) %> of <%= number_with_delimiter(@blocking.total) %> done.
          </p>
        <% end %>
      </div>

      <% if @flatfile_stale %>
        <%= form_with url: admin_regenerate_flatfiles_path, method: :post, local: true, class: 'mb-0' do |f| %>
          <%= hidden_field_tag :target, 'submission' %>
          <%= hidden_field_tag :submission_id, @submission.id %>

          <%# The dates stay as they are. This press is about what the file %>
          <%# contains, and a run that names no date renders every entry %>
          <%# from the column — and refuses if the column and the record %>
          <%# disagree, which is the guard doing its job. RegenerationScope %>
          <%# refuses a date on this target as well, because a hidden field %>
          <%# is a courtesy rather than a rule. %>
          <%= hidden_field_tag :date_mode, 'keep' %>

          <%= f.submit 'Regenerate this flatfile', class: 'btn btn-primary btn-sm', disabled: @blocking.present? %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary small" data-test-retracted-entries>
      Canceled and withdrawn entries are left out of the flatfile the next time it
      is generated. They stay in the record.
    </p>
  <% end %>

  <%# Filter (GET), the same shape as the Samples tab: the curator narrows %>
  <%# to the group they are fixing, and the bulk bar below acts on exactly %>
  <%# that group. An ST.26 submission can carry 27K entries. %>
  <%= form_with url: entries_admin_submission_request_path(@request), method: :get, local: true,
                class: 'row g-2 align-items-end bg-body-tertiary border rounded p-3 mb-3' do %>
    <div class="col-md-5">
      <%= label_tag :q, 'Search', class: 'form-label form-label-sm' %>
      <%= search_field_tag :q, @search.q, class: 'form-control form-control-sm',
                           placeholder: 'entry ID, accession' %>
    </div>

    <div class="col-md-3">
      <%= label_tag :status, 'Status', class: 'form-label form-label-sm' %>
      <%= select_tag :status,
                     options_for_select(Entry.statuses.keys.map {|s| [s.tr('_', ' ').capitalize, s] }, @search.statuses.first),
                     include_blank: 'Any', class: 'form-select form-select-sm' %>
    </div>

    <div class="col-md-4 d-flex gap-2">
      <%= submit_tag 'Filter', class: 'btn btn-primary btn-sm', name: nil %>

      <% if @search.active? %>
        <%= link_to 'Clear', entries_admin_submission_request_path(@request), class: 'btn btn-link btn-sm' %>
      <% end %>
    </div>
  <% end %>

  <%= form_with url:                bulk_update_entries_admin_submission_path(@submission, @search.to_params),
                method:             :post,
                scope:              :bulk_row,
                local:              true,
                authenticity_token: form_authenticity_token,
                data:               {controller: 'bulk-select'} do |f| %>
    <table class="table border align-middle">
      <thead class="table-light">
        <tr>
          <th style="width: 1rem;">
            <input type="checkbox" class="form-check-input" data-bulk-select-target="toggle" aria-label="Select all on this page">
          </th>
          <th>Accession</th>
          <th>Entry ID</th>
          <th>Version</th>
          <th>LOCUS date</th>
          <th>Status</th>
        </tr>
      </thead>

      <tbody>
        <% @entries.each do |entry| %>
          <tr>
            <td>
              <%= f.check_box :ids,
                              {multiple: true, class: 'form-check-input', data: {bulk_select_target: 'row'}, 'aria-label': "Select #{entry.entry_id}"},
                              entry.id, nil %>
            </td>
            <td><%= tag.code entry.accession %></td>
            <td class="font-monospace small"><%= entry.entry_id %></td>
            <td class="text-body-secondary"><%= entry.version %></td>
            <td class="text-body-secondary"><%= entry.locus_date %></td>
            <td>
              <span class="badge text-bg-<%= Admin::ViewHelpers::CURATION_STATUS_COLORS.fetch(entry.status, 'secondary') %> text-capitalize">
                <%= entry.status.tr('_', ' ') %>
              </span>
            </td>
          </tr>
        <% end %>

        <% if @entries.empty? %>
          <tr>
            <td colspan="6">
              <%# A submission with no entries at all is not a filter %>
              <%# problem, and saying it is sends the reader looking for a %>
              <%# filter to clear. %>
              <% if @search.active? %>
                <%= empty_state :filtered, 'No entries match this filter.',
                                @search.to_params.map { |key, value| "#{key.to_s.capitalize}: #{Array(value).join(', ')}" }.join(' · ') do %>
                  <%= link_to 'Clear filters', entries_admin_submission_request_path(@request),
                              class: 'btn btn-sm btn-outline-secondary' %>
                <% end %>
              <% else %>
                <%= empty_state :first_run, 'This submission has no entries.' %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render 'admin/shared/pagy_nav', pagy: @entries_pagy %>

    <% if @matching_count.positive? %>
      <div class="bulk-bar bg-dark text-white rounded-3 p-3 d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-3">
          <div class="form-check mb-0">
            <%= f.radio_button :scope, 'selected', checked: true, class: 'form-check-input' %>
            <%= f.label :scope_selected, class: 'form-check-label text-nowrap' do %>
              <span data-bulk-select-target="counter">0</span> selected on this page
            <% end %>
          </div>

          <div class="form-check mb-0">
            <%= f.radio_button :scope, 'filtered', class: 'form-check-input' %>
            <%= f.label :scope_filtered, "All #{number_with_delimiter(@matching_count)} matching the filter",
                        class: 'form-check-label text-nowrap' %>
          </div>
        </div>

        <span class="flex-fill"></span>

        <%# Settable, not every status: the pipeline writes the rest, and %>
        <%# offering one would report a bulk update that changed nothing. %>
        <%= f.select :status,
                     Entry::SETTABLE_STATUSES.map {|s| [s.tr('_', ' ').capitalize, s] },
                     {include_blank: 'Status — leave as-is'},
                     class: 'form-select form-select-sm w-auto' %>

        <%# Reversible — the flatfile is regenerated from the statuses, so %>
        <%# setting one back puts the entry back. No confirmation. %>
        <%= f.submit 'Apply', class: 'btn btn-outline-light btn-sm' %>
      </div>
    <% end %>
  <% end %>
<% end %>
