<% content_for :title, "##{@request.id} — Samples" %>

<%= render layout: 'workbench', locals: {tab: :samples} do %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">
      Samples
      <span class="text-body-secondary fw-normal"><%= number_with_delimiter(@state.row_count) %></span>
    </h2>

    <%# 100K-sample submissions are curated via TSV round-trip rather than %>
    <%# per-row editing. Export streams the current sample bag; upload %>
    <%# enqueues an async import that re-projects v3 attributes + typed %>
    <%# columns and surfaces a per-row error report. %>
    <div class="d-flex align-items-center gap-2">
      <%= link_to 'Download TSV', admin_submission_sample_tsv_export_path(@submission), class: 'btn btn-outline-secondary btn-sm' %>

      <%= form_with url:       admin_submission_sample_tsv_imports_path(@submission),
                    method:    :post,
                    multipart: true,
                    local:     true,
                    class:     'd-inline-flex align-items-center gap-2' do |f| %>
        <%= f.file_field :file, accept: 'text/tab-separated-values,text/plain,.tsv,.txt', required: true, class: 'form-control form-control-sm' %>
        <%= f.submit 'Upload TSV', class: 'btn btn-outline-secondary btn-sm text-nowrap' %>
      <% end %>
    </div>
  </div>

  <p class="text-body-secondary small">
    Blank attribute cells in an uploaded TSV delete the attribute; new column
    headers add new attributes. The identifier column is <code>sample_name</code>;
    <code>accession</code> is read-only context.
  </p>

  <%# Filter (GET). This is what makes the screen usable at 100K rows: the %>
  <%# curator narrows to the group they are fixing, and the bulk bar below %>
  <%# can then act on exactly that group. %>
  <%= form_with url: samples_admin_submission_request_path(@request), method: :get, local: true,
                class: 'row g-2 align-items-end bg-body-tertiary border rounded p-3 mb-3' do %>
    <div class="col-md-4">
      <%= label_tag :q, 'Search', class: 'form-label form-label-sm' %>
      <%= search_field_tag :q, @search.q, class: 'form-control form-control-sm',
                           placeholder: 'Sample name, organism, accession…' %>
    </div>

    <div class="col-md-2">
      <%= label_tag :status, 'Status', class: 'form-label form-label-sm' %>
      <%= select_tag :status,
                     options_for_select(Sample.statuses.keys.map {|s| [s.tr('_', ' ').capitalize, s] }, @search.statuses.first),
                     include_blank: 'Any', class: 'form-select form-select-sm' %>
    </div>

    <div class="col-md-2">
      <%= label_tag :accession, 'Accession', class: 'form-label form-label-sm' %>
      <%= select_tag :accession,
                     options_for_select(SampleSearch::ACCESSION_STATES.map {|value, label| [label, value] }, @search.accession_state),
                     include_blank: 'Any', class: 'form-select form-select-sm' %>
    </div>

    <div class="col-md-2 d-flex gap-2">
      <%= submit_tag 'Filter', class: 'btn btn-primary btn-sm' %>
      <% if @search.active? %>
        <%= link_to 'Clear', samples_admin_submission_request_path(@request), class: 'btn btn-link btn-sm' %>
      <% end %>
    </div>
  <% end %>

  <p class="text-body-secondary small">
    <%= number_with_delimiter(@matching_count) %> of <%= number_with_delimiter(@state.row_count) %> shown<%= ' (filtered)' if @search.active? %>.
  </p>

  <%# Both bulk actions post from this one form: Apply patches the rows, %>
  <%# Issue SAMD walks the same target set through AccessionIssue. The %>
  <%# current filter rides in the action URL so "all matching" is %>
  <%# re-derived server-side rather than trusted from a posted id list. %>
  <%# POST, not PATCH, and the session-wide CSRF token rather than the %>
  <%# per-form one — see admin/submission_requests/_request_list for both. %>
  <%= form_with url:                bulk_update_samples_admin_submission_path(@submission, @search.to_params),
                method:             :post,
                scope:              :bulk_sample,
                local:              true,
                authenticity_token: form_authenticity_token,
                data:               {controller: 'bulk-select'} do |f| %>
    <table class="table border align-middle">
      <thead class="table-light">
        <tr>
          <th style="width: 1rem;">
            <input type="checkbox" class="form-check-input" data-bulk-select-target="toggle" aria-label="Select all on this page">
          </th>
          <th>Accession</th>
          <th>Sample name</th>
          <th>Package</th>
          <th>Organism</th>
          <th>Tax ID</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @samples.each do |sample| %>
          <tr>
            <td>
              <%= f.check_box :sample_ids,
                              {multiple: true, class: 'form-check-input', data: {bulk_select_target: 'row'}, 'aria-label': "Select #{sample.sample_name}"},
                              sample.id, nil %>
            </td>
            <td><%= sample.accession ? tag.code(sample.accession) : '—' %></td>
            <td><%= sample.sample_name %></td>
            <td class="text-body-secondary"><%= sample.package || '—' %></td>
            <td class="text-body-secondary"><%= sample.organism || '—' %></td>
            <td class="text-body-secondary font-monospace"><%= sample.taxonomy_id || '—' %></td>
            <td>
              <span class="badge text-bg-<%= Admin::ViewHelpers::CURATION_STATUS_COLORS.fetch(sample.status, 'secondary') %> text-capitalize">
                <%= sample.status.tr('_', ' ') %>
              </span>
            </td>
          </tr>
        <% end %>

        <% if @samples.empty? %>
          <tr>
            <td colspan="7" class="text-center text-body-secondary py-4">No samples match this filter.</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render 'admin/shared/pagy_nav', pagy: @samples_pagy %>

    <% if @matching_count.positive? %>
      <div class="bulk-bar bg-dark text-white rounded-3 p-3 d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-3">
          <div class="form-check mb-0">
            <%= f.radio_button :scope, 'selected', checked: true, class: 'form-check-input' %>
            <%= f.label :scope_selected, class: 'form-check-label text-nowrap' do %>
              <span data-bulk-select-target="counter">0</span> selected on this page
            <% end %>
          </div>

          <div class="form-check mb-0">
            <%= f.radio_button :scope, 'filtered', class: 'form-check-input' %>
            <%= f.label :scope_filtered, "All #{number_with_delimiter(@matching_count)} matching the filter",
                        class: 'form-check-label text-nowrap' %>
          </div>
        </div>

        <span class="flex-fill"></span>

        <%= f.select :status,
                     Sample.statuses.keys.map {|s| [s.tr('_', ' ').capitalize, s] },
                     {include_blank: 'Status — leave as-is'},
                     class: 'form-select form-select-sm w-auto' %>

        <%# Reversible, so no confirmation — see the ledger's Apply. %>
        <%= f.submit 'Apply', class: 'btn btn-outline-light btn-sm' %>

        <%# Issue is the other way round: through the confirmation, %>
        <%# because it names how many numbers this allocates and cannot %>
        <%# be taken back. Into the frame the workbench above already %>
        <%# renders — see the ledger's copy of this button. %>
        <%= f.button "Issue #{@state.accession_prefix}",
                     type:       :submit,
                     formaction: confirm_admin_submission_accessions_path(@submission, @search.to_params),
                     class:      'btn btn-warning btn-sm text-nowrap',
                     data:       {turbo_frame: 'accession_confirm'} %>
      </div>
    <% end %>
  <% end %>
<% end %>
