<%# locals: (views:, assignee_ids:, assignee_labels:, filters:) %>
<%# The filter combinations a curator comes back to, as names.
    Nothing is stored here that the URL did not already carry — a chip is
    a link to the ledger with the saved params, so it lands on an
    ordinary shareable address and not on a private page. %>

<%# `filters` is the normalised form, so this asks "is anything actually
    filtered" rather than "is any facet present". They differ on the most
    common route to this screen: the facet groups sit inside the search
    form with every box checked, so a bare Search posts every value of
    every facet — which the ledger reads as no constraint and which must
    not become a saved view of everything. %>
<% savable   = filters.any? %>

<%# Key, not value. A refused save comes back with what was typed, and
    what was typed can be nothing at all — "Name can't be blank" is the
    one refusal where the field is empty, and asking for `present?` shut
    the form on exactly that message. %>
<% naming    = params.key?(:view_name) %>
<% return_to = filters.merge(page: params[:page].presence).compact %>

<% if views.any? || savable %>
  <div class="d-flex align-items-center gap-2 flex-wrap mb-2" data-test-saved-views>
    <% if views.any? %>
      <span class="small text-body-secondary">Saved</span>
    <% end %>

    <%# A toggle, not a chip with a remove button on it.

        The obvious thing to press to take an applied view off is the ×
        beside its name — and the × meant "delete this saved view for
        good", so the free operation and the irreversible one were the
        same gesture in the same place. Pressing an applied view again
        releases it instead: back to the bare ledger, which is where the
        curator was trying to get.

        Deleting has moved into the ▾, where it is managed rather than
        used. Not a delete mode: that would make everybody carry a
        memory of it for the sake of a rare press. %>
    <% views.each do |view| %>
      <% stale   = view.staleness(assignee_ids:) %>
      <% current = view.showing?(params, assignee_ids:) %>

      <%# The name truncates — it is free text, and one long one turns the
          row into a wall — but the markers do not: they are the state,
          and a state that can be cut off is not one.

          "on" rather than only a colour. Which of the two things this
          press does depends on whether the view is showing, and the
          explanation used to live in the `title`, where it took a
          deliberate hover to find and was therefore no explanation at
          all. %>
      <%= link_to (current ? admin_submission_requests_path : admin_submission_requests_path(view.to_query)),
                  class: "btn btn-sm #{saved_view_button_class(current:, stale: stale.any?)} d-inline-flex align-items-center gap-1",
                  style: 'max-width: 16rem;',
                  'aria-current': ('true' if current),
                  title: saved_view_title(view, stale, assignee_labels, current:),
                  'data-test-saved-view': view.name,
                  'data-test-saved-view-stale': (view.name if stale.any?) do %>
        <span class="text-truncate"><%= view.name %></span>

        <% if stale.any? %>
          <span class="badge text-bg-warning" data-test-saved-view-stale-badge>!</span>
        <% end %>

        <% if current %>
          <span class="badge text-bg-light border">on · press to clear</span>
        <% end %>
      <% end %>
    <% end %>

    <%# Where a view is managed, as opposed to where it is used.
        `auto-close="outside"` so renaming one does not shut the menu on
        the way. %>
    <% if views.any? %>
      <div class="dropdown">
        <button class="btn btn-sm btn-link text-decoration-none dropdown-toggle" type="button"
                data-bs-toggle="dropdown" data-bs-auto-close="outside"
                aria-expanded="false" aria-label="Manage saved views">Manage</button>

        <div class="dropdown-menu p-2" style="min-width: 20rem;" data-test-manage-saved-views>
          <h6 class="dropdown-header px-2">Saved views</h6>

          <% views.each do |view| %>
            <div class="d-flex align-items-center gap-2 px-2 py-1">
              <span class="flex-fill text-truncate"><%= view.name %></span>

              <button class="btn btn-sm btn-link text-decoration-none p-0" type="button"
                      data-bs-toggle="collapse" data-bs-target="#rename-view-<%= view.id %>"
                      aria-controls="rename-view-<%= view.id %>" aria-expanded="false"
                      aria-label="Rename <%= view.name %>">Rename</button>

              <%# The one irreversible thing on this row, so it is the
                  one thing that asks. The ledger's bulk Apply has no
                  confirmation on purpose — it can be undone by pressing
                  again — and this cannot: the filter a view names is
                  written down nowhere else. %>
              <%= button_to 'Delete', admin_saved_view_path(view, return_to), method: :delete,
                            class: 'btn btn-sm btn-link text-decoration-none p-0',
                            form: {class: 'd-inline', data: {turbo_confirm: "Delete the saved view “#{view.name}”? The filter it names is not stored anywhere else."}},
                            'aria-label': "Delete saved view #{view.name}" %>
            </div>

            <div class="collapse px-2 pb-2" id="rename-view-<%= view.id %>">
              <%= form_with url: admin_saved_view_path(view, return_to), method: :patch,
                            class: 'd-flex gap-2 align-items-center' do %>
                <%= text_field_tag :name, view.name, class: 'form-control form-control-sm',
                                   maxlength: SavedView::MAX_NAME_LENGTH, id: nil,
                                   'aria-label': "New name for #{view.name}" %>

                <%= submit_tag 'Save name', class: 'btn btn-sm btn-outline-secondary text-nowrap' %>
              <% end %>
            </div>
          <% end %>

          <% if savable %>
            <div class="dropdown-divider"></div>

            <button class="btn btn-sm btn-link text-decoration-none" type="button"
                    data-bs-toggle="collapse" data-bs-target="#save-view"
                    aria-controls="save-view" aria-expanded="<%= naming %>">Save the current filter…</button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Only where there is something to name. On an unfiltered ledger it
        would offer to save "everything", which is the link in the nav. %>
    <% if savable %>
      <button class="btn btn-sm btn-link text-decoration-none" type="button"
              data-bs-toggle="collapse" data-bs-target="#save-view"
              aria-expanded="<%= naming %>" aria-controls="save-view">
        Save this view
      </button>
    <% end %>
  </div>

  <%# Folded away until asked for — chips, a text box and a button
      competing along one line, where only the chips are read at a
      glance, was most of what made this row unreadable. Open again when
      a save was refused, with what was typed still in it. %>
  <% if savable %>
    <div class="collapse <%= 'show' if naming %> mb-2" id="save-view">
      <%= form_with url: admin_saved_views_path, method: :post, class: 'd-flex gap-2 align-items-center' do %>
        <% filters.each do |key, value| %>
          <% Array(value).each do |v| %>
            <%= hidden_field_tag "#{key}#{'[]' if value.is_a?(Array)}", v, id: nil %>
          <% end %>
        <% end %>

        <%= hidden_field_tag :page, params[:page], id: nil if params[:page].present? %>

        <%= text_field_tag :name, params[:view_name].presence || suggested_view_name(params, assignee_ids:),
                           class: 'form-control form-control-sm', style: 'max-width: 16rem;',
                           maxlength: SavedView::MAX_NAME_LENGTH,
                           'aria-label': 'Name for this view', placeholder: 'Name this view' %>

        <%= submit_tag 'Save', class: 'btn btn-sm btn-primary',
                       data: {turbo_submits_with: 'Saving…'} %>

        <%# A way out. The collapse toggle does close it again, but that
            is a thing to work out rather than to see, and after a
            refused save it is not enough on its own: `view_name` is in
            the URL by then, so closing it client-side leaves a form that
            reopens on the next reload.

            A link rather than a toggle, so one control covers both — it
            lands on the same rows with the form shut and the param
            dropped. The rename form beside it needs none of this: its
            menu closes when you press anywhere else. %>
        <%= link_to 'Cancel', admin_submission_requests_path(return_to),
                    class: 'btn btn-sm btn-link text-decoration-none' %>

        <%# What is actually stored, which is not the same as the badge
            row beside the search box: that one reports facets, this one
            reports the view — the query included, the fully-ticked
            facets left out. %>
        <span class="small text-body-secondary">Saves <%= saved_view_summary(filters) %>.</span>
      <% end %>
    </div>
  <% end %>
<% end %>
