<% content_for :title, 'Needs action' %>

<%= render 'admin/shared/breadcrumb', items: [{label: 'Needs action'}] %>

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-1">
  <h1 class="display-6 mb-0">Needs action</h1>

  <%# A filter on the same queue, not a different screen — a curator can %>
  <%# look up from their own work and back without losing their place. %>
  <div class="btn-group btn-group-sm" role="group" aria-label="Queue scope">
    <%= link_to 'Everyone', admin_root_path,
                class: "btn btn-outline-secondary #{'active' if !@mine}",
                'aria-current': ('true' if !@mine) %>
    <%= link_to 'Mine only', admin_root_path(mine: 1),
                class: "btn btn-outline-secondary #{'active' if @mine}",
                'aria-current': ('true' if @mine) %>
  </div>
</div>

<p class="text-body-secondary mb-4">
  <%= pluralize(@total, 'request') %>
  <%= @total == 1 ? 'is' : 'are' %> waiting on a curator — not on submitters.
  Oldest first.
</p>

<% @buckets.each do |listing| %>
  <section class="mb-4">
    <div class="d-flex align-items-baseline gap-2 flex-wrap mb-2">
      <h2 class="h6 mb-0"><%= listing.bucket.title %></h2>
      <span class="badge <%= listing.count.positive? ? 'text-bg-danger' : 'text-bg-secondary' %>">
        <%= number_with_delimiter(listing.count) %>
      </span>
      <%# Why a request is in this bucket, written next to the bucket — so %>
      <%# the queue's meaning is on screen rather than in a remembered %>
      <%# filter combination. %>
      <span class="small text-body-tertiary"><%= listing.bucket.criterion %></span>
    </div>

    <% if listing.requests.empty? %>
      <p class="small text-body-secondary fst-italic mb-0">Nothing here.</p>
    <% else %>
      <div class="list-group">
        <% listing.requests.each do |request| %>
          <%= render 'row', request: request, action: listing.bucket.action %>
        <% end %>
      </div>

      <% if listing.overflow.positive? %>
        <p class="small text-body-secondary mt-2 mb-0">
          <%= number_with_delimiter(listing.overflow) %> more —
          <%= link_to 'open in All requests', admin_submission_requests_path %>.
        </p>
      <% end %>
    <% end %>
  </section>
<% end %>
