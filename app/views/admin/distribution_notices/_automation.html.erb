<%# The schedule as it is actually configured, read from the file %>
<%# SolidQueue reads — so editing recurring.yml cannot leave this line %>
<%# quietly claiming a time nothing runs at. %>
<% schedule = DistributionNotifier.schedule %>
<% run      = DistributionNotice.last_scheduled_run.to_a %>

<div class="alert alert-light border d-flex align-items-center gap-3 flex-wrap py-2">
  <span class="badge text-bg-success">AUTO</span>

  <span class="small">
    <% if schedule %>
      Sending automatically <%= schedule %>.
    <% else %>
      The daily send is not scheduled on this environment.
    <% end %>

    <% if run.any? %>
      <% delivered = run.select(&:delivered_result?) %>
      <% skipped   = run.count(&:skipped_result?) %>
      Last run <%= format_datetime(run.first.sent_at) %> —
      <%= pluralize(delivered.sum { it.accessions.size }, 'notice') %>
      to <%= pluralize(delivered.size, 'submitter') %><%= ", #{skipped} skipped" if skipped.positive? %>.
    <% else %>
      It has not run yet.
    <% end %>
  </span>

  <span class="flex-fill"></span>

  <%# The job's own record of the run — retries, exceptions, timing — %>
  <%# lives in Mission Control, and this screen should point at it rather %>
  <%# than paraphrase it. %>
  <%= link_to 'View the run in Jobs', admin_mission_control_jobs_path, class: 'small' %>
</div>
