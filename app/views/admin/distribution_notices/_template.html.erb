<%# One form, two intents. `button_to` renders its own <form>, and a form %>
<%# nested inside another is dropped by every HTML parser — the button %>
<%# then belongs to the outer form, so "Send a test to me" would have %>
<%# saved the template and published the edit to every submitter, which %>
<%# is the exact outcome it exists to let a curator avoid. Two submits %>
<%# with a `commit` value keep it one form; the controller dispatches. %>
<div class="row g-4" data-controller="notice-preview"
     data-notice-preview-placeholder-value="<%= DistributionNotifierTemplate::PLACEHOLDER %>">
  <div class="col-lg-6">
    <%= form_with model: @template, url: admin_distribution_notice_template_path, method: :patch,
                  scope: :distribution_notifier_template do |f| %>
      <% if @template.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @template.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :subject, class: 'form-label' %>
        <%= f.text_field :subject, class: 'form-control',
                         data: {notice_preview_target: 'subject', action: 'input->notice-preview#render'} %>
      </div>

      <div class="mb-3">
        <%= f.label :body, class: 'form-label' %>
        <%= f.text_area :body, rows: 14, class: 'form-control font-monospace',
                        data: {notice_preview_target: 'body', action: 'input->notice-preview#render'} %>
      </div>

      <div class="d-flex gap-2 align-items-center flex-wrap">
        <%# `f.button`, not `f.submit`: submit_tag renders its value AS the %>
        <%# label, so naming the intent would have relabelled the button. %>
        <%= f.button 'Save', name: 'commit', value: 'save', class: 'btn btn-primary' %>

        <%# Saving is publishing: the next run sends this to everybody. A %>
        <%# copy addressed to yourself first is the difference between %>
        <%# checking and finding out — and it is rendered from what is in %>
        <%# the form, not from what is saved, or it would test the text %>
        <%# being replaced. %>
        <%= f.button 'Send a test to me', name: 'commit', value: 'test', class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>

  <div class="col-lg-6">
    <%# The placeholder used to be explained in a paragraph. A worked %>
    <%# example of the same thing says it better, and catches the case %>
    <%# prose cannot: a body that reads fine and expands wrong. %>
    <div class="card" data-test-preview>
      <div class="card-header d-flex justify-content-between align-items-baseline gap-2 flex-wrap">
        <span class="fw-semibold">Preview</span>

        <% if @preview.available? %>
          <span class="small text-body-secondary">as sent to <%= @preview.user.uid %></span>
        <% end %>
      </div>

      <div class="card-body">
        <% if @preview.available? %>
          <dl class="row small mb-3">
            <dt class="col-2 fw-normal text-body-secondary">To</dt>
            <dd class="col-10"><%= @preview.to %></dd>

            <dt class="col-2 fw-normal text-body-secondary">Subject</dt>
            <dd class="col-10" data-notice-preview-target="subjectPreview"><%= @preview.subject %></dd>
          </dl>

          <div class="border-top pt-3 small" style="white-space: pre-wrap;"><span data-notice-preview-target="before"><%= @preview.before %></span>

<span class="d-inline-block bg-warning-subtle rounded px-2 py-1"><% @preview.notices.each do |notice| %><%= notice.to_line %>
<% end %></span>

<span data-notice-preview-target="after"><%= @preview.after %></span></div>

          <p class="small text-body-tertiary mt-3 mb-0">
            The highlighted block is where <code><%= DistributionNotifierTemplate::PLACEHOLDER %></code>
            expands — plain text in the text part, links in the HTML part.
          </p>
        <% else %>
          <p class="small text-body-secondary fst-italic mb-0">
            Nothing is due, so there is no real notice to render. The preview shows an actual
            candidate rather than a specimen, so it appears once somebody is due.
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
