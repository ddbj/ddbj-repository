<% content_for :title, 'Log in' %>

<%# "Sign in required" states the system's condition; this is a place, so %>
<%# it says what to do and where it leads. The origin was already carried %>
<%# in a hidden field — showing it is what turns "log in" into "log in and %>
<%# get back to what you were doing". %>
<div class="row justify-content-center py-4">
  <div class="col-12 col-md-9 col-lg-7">
    <div class="card">
      <div class="card-body p-4 p-md-5">
        <div class="text-uppercase text-body-tertiary fw-semibold small mb-2" style="letter-spacing: .08em;">
          Curator area
        </div>

        <h1 class="h3 mb-2">Log in to continue</h1>
        <p class="text-body-secondary">Curation tools are restricted to DDBJ staff accounts.</p>

        <% if @origin.present? %>
          <div class="d-flex align-items-center gap-2 small bg-body-tertiary border rounded p-2 my-3">
            <span class="text-body-secondary">After login you return to</span>
            <code><%= @origin %></code>
          </div>
        <% end %>

        <%# data-turbo="false": OmniAuth's request phase 302-redirects to %>
        <%# Keycloak (a different origin). Left to Turbo, the form posts via %>
        <%# fetch() which follows that redirect as a cross-origin request and %>
        <%# is blocked by CORS. A native submission is a top-level navigation, %>
        <%# which CORS does not apply to. Mirrors the Logout / "Back to %>
        <%# repository" controls in the admin layout. %>
        <form action="/auth/keycloak" method="post" data-turbo="false" class="mt-3">
          <input type="hidden" name="origin" value="<%= @origin %>">
          <button type="submit" class="btn btn-primary btn-lg">Log in with DDBJ Account</button>
        </form>

        <p class="text-body-secondary small mb-0 mt-4 pt-3 border-top">
          Need curator access? Ask a DDBJ administrator to enable it for your account.
          Submitters can continue in the
          <%= link_to 'submitter view', WebApp.url_for, data: {turbo: false} %>.
        </p>
      </div>
    </div>
  </div>
</div>
