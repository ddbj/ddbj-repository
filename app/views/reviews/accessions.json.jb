# One page of the accessions on the link, as the reviewer sees them: what
# each record states, and nothing about who submitted it or how DDBJ is
# handling it.
@rows.map {|row|
  facts = AccessionFacts.for(row)

  {
    accession: facts.accession,
    db:        facts.db,
    name:      facts.name,
    details:   facts.details
  }
}
