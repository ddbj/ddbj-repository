# The reviewer's view of the entries. Deliberately not
# `accessions/index`: this one is reached without authenticating, so it
# carries what identifies an entry and nothing about where DDBJ has got
# to with it.
@accessions.map {|entry|
  {
    accession:  entry.accession,
    entry_id:   entry.entry_id,
    version:    entry.version,
    locus_date: entry.locus_date
  }
}
