# What one shared accession's record says.
#
# The same layout the submitter's own screen draws, beside the same facts
# the link's list carries — and nothing else. Where DDBJ has got to with
# the row is not here, for the reason the message thread is unreachable
# from a share link: a reviewer is shown what the record states, not how
# it is being handled.
facts = AccessionFacts.for(@row)

{
  accession: facts.accession,
  db:        facts.db,
  name:      facts.name,
  details:   facts.details,

  record: render('records/slice', slice: @slice, outline: @outline)
}
