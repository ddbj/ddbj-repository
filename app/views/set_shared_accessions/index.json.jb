# One page of what the link carries, as the set's members see it.
#
# Not the reviewer's template. That one carries the facts each record
# states; this one carries who each accession belongs to and whether the
# reader may take it off, which is the whole of what a member needs and
# none of what a reviewer should be told.
@rows.map {|row|
  facts = AccessionFacts.for(row)

  {
    accession: facts.accession,
    db:        facts.db,
    name:      facts.name,

    # Whose it is, and whether it is yours to take off. Said by the server
    # for the same reason `owned` is on a set's submissions: under a proxy
    # login the account the client believes it is is not the account the
    # server acts as, so comparing uids in the browser gets it backwards.
    owner_uid: row.submission.user.uid,
    owned:     row.submission.user_id == @viewer.id
  }
}
